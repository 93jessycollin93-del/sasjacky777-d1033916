            },
            "description": {
              "description": "Optional longer detail.",
              "type": "string"
            },
            "status": {
              "description": "Column to start in (default todo).",
              "type": "string",
              "enum": [
                "todo",
                "in_progress",
                "done",
                "blocked"
              ]
            },
            "priority": {
              "description": "Priority (default medium).",
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "critical"
              ]
            },
            "category": {
              "description": "Optional grouping category.",
              "type": "string"
            },
            "due_date": {
              "description": "Optional ISO 8601 due date.",
              "type": "string"
