            },
            "auth_type": {
              "description": "none, bearer, header or query (default none).",
              "type": "string",
              "enum": [
                "none",
                "bearer",
                "header",
                "query"
              ]
            },
            "auth_name": {
              "description": "The header or query parameter the key goes in, for header/query.",
              "type": "string"
            },
            "operations": {
              "minItems": 1,
              "maxItems": 20,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "method": {
                    "type": "string",
                    "enum": [
                      "GET",
                      "POST",
                      "PUT",
                      "PATCH",
                      "DELETE"
                    ]
                  },
                  "path": {
                    "type": "string",
                    "description": "Starts with /; {name} for a path parameter."
                  },
                  "params": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "in": {
                          "type": "string",
                          "enum": [
                            "path",
                            "query",
                            "body"
                          ]
                        },
                        "type": {
                          "type": "string",
                          "enum": [
                            "string",
                            "number",
                            "boolean"
                          ]
                        },
                        "required": {
                          "type": "boolean"
                        },
                        "description": {
                          "type": "string"
                        },
                        "maxLength": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "name",
                        "in",
                        "type"
                      ]
                    }
                  }
                },
                "required": [
                  "name",
                  "description",
                  "method",
                  "path"
                ]
              }
            }
          },
          "required": [
            "name",
            "title",
            "description",
            "base_url",
            "operations"
          ],
          "additionalProperties": false
        },
