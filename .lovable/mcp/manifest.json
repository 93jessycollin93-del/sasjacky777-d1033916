    "tools": [
      {
        "name": "ask_jackie",
        "title": "Ask Jackie",
        "description": "Send a message to Jackie and get her answer. She sees the user's memory and active tasks. The exchange is saved to a conversation in the app (a new one unless conversation_id is given).",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20000,
              "description": "What to say to Jackie."
            },
            "conversation_id": {
              "description": "Continue this conversation (its recent history is sent).",
              "type": "string"
            },
            "title": {
              "description": "Title for a new conversation.",
              "type": "string"
            },
            "engine": {
              "description": "Which engine answers (default cloud). bionic and ollama answer the owner only.",
              "type": "string",
              "enum": [
                "cloud",
                "deepseek",
                "bionic",
                "ollama"
              ]
            },
            "model": {
              "description": "Model id for that engine; omit for its default.",
              "type": "string"
            }
          },
          "required": [
            "message"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_tasks",
