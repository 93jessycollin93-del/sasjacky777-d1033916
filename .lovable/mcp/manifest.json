                      "search_memory",
                      "remember_fact",
                      "forget_fact",
                      "list_conversations",
                      "read_conversation",
                      "create_conversation",
                      "ask_jackie",
                      "call_connection"
                    ]
                  },
                  "args": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  }
                },
                "required": [
                  "action"
